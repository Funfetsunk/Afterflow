[resource]
script = ExtResource("1")
id = &"woodland"
title = "The Old Wood"
text = "The Old Wood is quieter than it should be. The birdsong stops at the treeline, as if the trees are holding their breath. The light comes down in long gold ribbons."
starts_written = false
